// Schéma Prisma — Financia (gestion financière personnelle)
// Convention monétaire : tous les montants sont stockés en Decimal(19,2)
// (type PostgreSQL NUMERIC) pour éviter les erreurs d'arrondi des flottants.
// Devise par défaut : MGA (Ariary).
//
// Note : le modèle financier `Account` représente un compte bancaire/espèces.
// Les futurs modèles Auth.js devront utiliser des noms distincts
// (p. ex. `AuthAccount`, `Session`) pour éviter toute collision.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum AccountType {
  CASH
  BANK
  MOBILE_MONEY
  SAVINGS
  CARD
  OTHER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  BUDGET_ALERT
  GOAL_UPDATE
  REMINDER
}

enum TransferRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String?
  lastName     String?
  name         String?
  passwordHash String?
  image        String?
  // Préférences d'affichage (modifiable via /settings, valeurs Zod côté app).
  // Devise unique : Ariary (MGA), sans sélecteur.
  locale            String @default("fr")
  dateFormat        String @default("dd/MM/yyyy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  goals         SavingsGoal[]
  notifications Notification[]
  sentTransferRequests     TransferRequest[] @relation("SentTransferRequests")
  receivedTransferRequests TransferRequest[] @relation("ReceivedTransferRequests")
}

model Account {
  id           String      @id @default(cuid())
  name         String
  type         AccountType @default(CASH)
  currency     String      @default("MGA") @db.Char(3)
  balance      Decimal     @default(0) @db.Decimal(19, 2)
  isArchived   Boolean     @default(false)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("AccountTransactions")
  transfersIn  Transaction[] @relation("TransferDestination")
  outgoingTransferRequests TransferRequest[] @relation("TransferSourceAccount")
  incomingTransferRequests TransferRequest[] @relation("TransferDestAccount")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, isArchived])
}

model Category {
  id           String          @id @default(cuid())
  name         String
  icon         String?
  color        String?
  type         TransactionType
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@index([userId, type])
}

model Transaction {
  id          String          @id @default(cuid())
  // Montant toujours positif ; le sens est porté par `type`.
  // Contrainte applicative : amount > 0 (validée via Zod côté app).
  amount      Decimal         @db.Decimal(19, 2)
  description String
  note        String?         @db.Text
  type        TransactionType
  date        DateTime        @default(now()) @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Compte destinataire pour les virements internes (type TRANSFER).
  toAccountId String?
  toAccount   Account? @relation("TransferDestination", fields: [toAccountId], references: [id], onDelete: SetNull)

  // Demande de transfert inter-utilisateurs ayant produit cette écriture
  // (acceptation). Null pour les transactions ordinaires.
  transferRequest TransferRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date(sort: Desc)])
  @@index([accountId, date(sort: Desc)])
  @@index([categoryId])
  @@index([userId, type, date(sort: Desc)])
}

model Budget {
  id         String       @id @default(cuid())
  name       String
  amountLimit Decimal     @db.Decimal(19, 2)
  period     BudgetPeriod @default(MONTHLY)
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Plus haut seuil d'alerte déjà notifié (0, 50, 75, 90 ou 100).
  // Évite les notifications en double lors des recalculs.
  lastNotifiedThreshold Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
  @@index([userId, period])
  @@index([categoryId])
}

model SavingsGoal {
  id            String     @id @default(cuid())
  name          String
  description   String?    @db.Text
  targetAmount  Decimal    @db.Decimal(19, 2)
  currentAmount Decimal    @default(0) @db.Decimal(19, 2)
  deadline      DateTime?  @db.Date
  status        GoalStatus @default(ACTIVE)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

/**
 * Demande de transfert inter-utilisateurs avec confirmation du destinataire.
 *
 * Cycle de vie : PENDING (aucun mouvement de fonds, aucune écriture) →
 * COMPLETED (acceptée : écriture TRANSFER + débit/crédit atomiques) |
 * REJECTED (refusée) | CANCELLED (annulée par l'expéditeur).
 * Les transferts entre propres comptes restent instantanés (createTransfer).
 */
model TransferRequest {
  id          String                @id @default(cuid())
  amount      Decimal               @db.Decimal(19, 2)
  description String?
  status      TransferRequestStatus @default(PENDING)

  senderId String
  sender   User   @relation("SentTransferRequests", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("ReceivedTransferRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  fromAccountId String
  fromAccount   Account @relation("TransferSourceAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)

  toAccountId String
  toAccount   Account @relation("TransferDestAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  // Écriture comptable créée à l'acceptation (null tant que PENDING).
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([senderId, status])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
}
