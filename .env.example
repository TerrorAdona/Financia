# Financia — configuration d'environnement
# Copiez ce fichier vers `.env` puis renseignez les valeurs :
#   Copy-Item .env.example .env   (Windows)
#   cp .env.example .env          (macOS / Linux)

# PostgreSQL (ex. local) — NE JAMAIS commiter le vrai `.env`.
DATABASE_URL="postgresql://financia:financia@localhost:5432/financia?schema=public"

# Auth.js (NextAuth v5) — secret aléatoire, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"

# URL publique de l'application (callbacks Auth.js, emails).
# Prod : "https://votre-domaine.exemple" (+ AUTH_TRUST_HOST="true" derrière un proxy).
AUTH_URL="http://localhost:3000"

# Assistant IA (Groq, niveau gratuit) — SANS cette clé, le widget répond
# simplement qu'il n'est pas configuré. Obtenir une clé : https://console.groq.com
# GROQ_API_KEY="votre-cle-groq"
# # Modèle Groq (optionnel).
# GROQ_MODEL="openai/gpt-oss-120b"
